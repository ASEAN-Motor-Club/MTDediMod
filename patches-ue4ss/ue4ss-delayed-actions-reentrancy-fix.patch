+    // Look up a live (non-cancelled) delayed action by handle in both the
+    // active and the pending queue. Callers must hold m_thread_actions_mutex.
+    static auto find_delayed_action(int64_t handle) -> LuaMod::DelayedGameThreadAction*
+    {
+        for (auto& action : LuaMod::m_delayed_game_thread_actions)
+        {
+            if (action.handle == handle && action.status != LuaMod::DelayedActionStatus::PendingRemoval)
+            {
+                return &action;
+            }
+        }
+        for (auto& action : LuaMod::m_pending_delayed_game_thread_actions)
+        {
+            if (action.handle == handle && action.status != LuaMod::DelayedActionStatus::PendingRemoval)
+            {
+                return &action;
+            }
+        }
+        return nullptr;
+    }
